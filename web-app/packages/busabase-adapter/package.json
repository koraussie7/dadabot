{
  "name": "@agentmesh/busabase-adapter",
  "version": "0.1.0",
  "description": "Human-in-the-loop approval workflow for Dadabot. Mirrors busabase's Change Request → Inbox pattern via GitHub PRs, with confidence + rationale + audit trail.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./change-request": "./src/change-request.ts",
    "./inbox": "./src/inbox.ts",
    "./policy": "./src/policy.ts",
    "./audit": "./src/audit.ts",
    "./octokit": "./src/octokit.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agentmesh",
    "dadabot",
    "human-in-the-loop",
    "approval-workflow",
    "busabase",
    "change-request",
    "ai-safety"
  ],
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
