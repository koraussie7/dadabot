{
  "name": "@agentmesh/infra-executor",
  "version": "0.1.0",
  "description": "Allowlist-gated infrastructure executor for Dadabot — validate → snapshot → precheck → execute → verify → rollback across Ubuntu nodes running nginx, Caddy/Charon, Traefik, Docker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./allowlist": "./src/allowlist.ts",
    "./runner": "./src/runner.ts",
    "./probes": "./src/probes.ts",
    "./rollback": "./src/rollback.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agentmesh",
    "dadabot",
    "infra",
    "ansible",
    "allowlist",
    "auto-remediation",
    "rollback"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
