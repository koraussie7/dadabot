{
  "name": "@agentmesh/dadabot-cli",
  "version": "0.1.0",
  "description": "Dadabot command-line interface — list/approve/reject ChangeRequests, run proposals through the safety pipeline, sync with the dashboard.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "dadabot": "./bin/dadabot.mjs"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agentmesh",
    "dadabot",
    "cli",
    "human-in-the-loop",
    "approval-workflow"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentmesh/busabase-adapter": "file:../../packages/busabase-adapter",
    "@agentmesh/affine-adapter": "file:../../packages/affine-adapter",
    "@agentmesh/proposal-bridge": "file:../../packages/proposal-bridge"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
