{
  "name": "@agentmesh/affine-adapter",
  "version": "0.1.0",
  "description": "BlockSuite reactive store headless adapter — block-canvas + Y.js CRDT for Dadabot. Embeds AFFiNE-style visual workspace without UI bloat.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store.ts",
    "./blocks": "./src/blocks.ts",
    "./sync": "./src/sync.ts",
    "./signals": "./src/signals.ts"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agentmesh",
    "dadabot",
    "blocksuite",
    "yjs",
    "crdt",
    "block-canvas",
    "affine"
  ],
  "license": "MIT",
  "dependencies": {
    "yjs": "^13.6.18",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^1.5.0",
    "y-protocols": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
